# Optional demo-login prefill for the Login screen (see src/App.tsx).
#
# For LOCAL development only: copy this file to `.env.development` and set
# your local demo password there. `.env.development` is git-ignored and is
# never loaded by `vite build`, so it cannot leak into a production bundle.
#
# For DEPLOYED builds: if a prefill is desired, set VITE_DEMO_EMAIL /
# VITE_DEMO_PASSWORD in your deployment's environment. Be aware these values
# are embedded in the client bundle and are not secrets.
VITE_API_URL=
VITE_DEMO_EMAIL=admin@demo.com
VITE_DEMO_PASSWORD=
